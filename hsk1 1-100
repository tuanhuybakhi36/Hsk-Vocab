            { id: 62, word: "大学", pinyin: "dàxué", meaning: "đại học" },
            { id: 63, word: "大学生", pinyin: "dàxuéshēng", meaning: "sinh viên đại học" },
            { id: 64, word: "到", pinyin: "dào", meaning: "đến, tới" },
            { id: 65, word: "得到", pinyin: "dédào", meaning: "đạt được, nhận được" },
            { id: 66, word: "地", pinyin: "de", meaning: "biểu thị từ trước nó là trạng ngữ" },
            { id: 67, word: "的", pinyin: "de", meaning: "(biểu thị sự sở hữu) của" },
            { id: 68, word: "等", pinyin: "děng", meaning: "đợi, chờ" },
            { id: 69, word: "地", pinyin: "dì", meaning: "đất, lục địa; trái đất" },
            { id: 70, word: "地点", pinyin: "dìdiǎn", meaning: "địa điểm, nơi chốn" },
            { id: 71, word: "地方", pinyin: "dìfang", meaning: "nơi, địa phương" },
            { id: 72, word: "地上", pinyin: "dìshang", meaning: "trên mặt đất" },
            { id: 73, word: "地图", pinyin: "dìtú", meaning: "bản đồ" },
            { id: 74, word: "弟弟| 弟", pinyin: "dìdi|dì", meaning: "em trai" },
            { id: 75, word: "第（第二）", pinyin: "dì（dì-èr）", meaning: "thứ ... (số thứ tự)" },
            { id: 76, word: "点", pinyin: "diǎn", meaning: "ít, chút, hơi" },
            { id: 77, word: "电", pinyin: "diàn", meaning: "điện, pin" },
            { id: 78, word: "电话", pinyin: "diànhuà", meaning: "điện thoại" },
            { id: 79, word: "电脑", pinyin: "diànnǎo", meaning: "máy tính" },
            { id: 80, word: "电视", pinyin: "diànshì", meaning: "truyền hình; TV" },

            // Group 5: 81 - 100
            { id: 81, word: "电视机", pinyin: "diànshìjī", meaning: "(chiếc) TV" },
            { id: 82, word: "电影", pinyin: "diànyǐng", meaning: "điện ảnh, phim (nói chung)" },
            { id: 83, word: "电影院", pinyin: "diànyǐngyuàn", meaning: "rạp chiếu phim" },
            { id: 84, word: "东", pinyin: "dōng", meaning: "đông" },
            { id: 85, word: "东边", pinyin: "dōngbian", meaning: "phía đông" },
            { id: 86, word: "东西", pinyin: "dōngxi", meaning: "đồ đạc, đồ, vật" },
            { id: 87, word: "动", pinyin: "dòng", meaning: "động, chạm" },
            { id: 88, word: "动作", pinyin: "dòngzuò", meaning: "động tác, hoạt động" },
            { id: 89, word: "都", pinyin: "dōu", meaning: "đều" },
            { id: 90, word: "读", pinyin: "dú", meaning: "đọc" },
            { id: 91, word: "读书", pinyin: "dúshū", meaning: "đọc sách" },
            { id: 92, word: "对", pinyin: "duì", meaning: "đúng" },
            { id: 93, word: "对不起", pinyin: "duìbuqǐ", meaning: "xin lỗi" },
            { id: 94, word: "多", pinyin: "duō", meaning: "nhiều / (đại từ) bao nhiêu" },
            { id: 95, word: "多少", pinyin: "duōshǎo", meaning: "bao nhiêu" },
            { id: 96, word: "饿", pinyin: "è", meaning: "đói" },
            { id: 97, word: "儿子", pinyin: "érzi", meaning: "con trai" },
            { id: 98, word: "二", pinyin: "èr", meaning: "số 2" },
            { id: 99, word: "饭", pinyin: "fàn", meaning: "cơm" },
            { id: 100, word: "饭店", pinyin: "fàndiàn", meaning: "quán ăn / nhà hàng" }
        ];

        // State variables
        let currentPool = [];
        let currentQuestions = [];
        let currentIndex = 0;
        let score = { correct: 0, incorrect: 0 };
        let hasAnswered = false;
        let incorrectReviews = [];
        let selectedBtn = null;

        // Shuffle helper
        function shuffle(array) {
            let currIndex = array.length, randomIndex;
            while (currIndex != 0) {
                randomIndex = Math.floor(Math.random() * currIndex);
                currIndex--;
                [array[currIndex], array[randomIndex]] = [array[randomIndex], array[currIndex]];
            }
            return array;
        }

        // Return to setup screen
        function goToSetup() {
            document.getElementById('setup-screen').classList.remove('hidden');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
        }

        // Initialize Quiz session
        function startQuiz() {
            const rangeMode = document.querySelector('input[name="vocab-range"]:checked').value;
            const orderMode = document.querySelector('input[name="order-mode"]:checked').value;
            const questionCountVal = document.getElementById('question-count').value;

            // Filter vocabulary range
            if (rangeMode === 'group1') {
                currentPool = vocabulary.filter(v => v.id >= 1 && v.id <= 20);
            } else if (rangeMode === 'group2') {
                currentPool = vocabulary.filter(v => v.id >= 21 && v.id <= 40);
            } else if (rangeMode === 'group3') {
                currentPool = vocabulary.filter(v => v.id >= 41 && v.id <= 60);
            } else if (rangeMode === 'group4') {
                currentPool = vocabulary.filter(v => v.id >= 61 && v.id <= 80);
            } else if (rangeMode === 'group5') {
                currentPool = vocabulary.filter(v => v.id >= 81 && v.id <= 100);
            } else {
                currentPool = [...vocabulary];
            }

            // Order questions
            if (orderMode === 'random') {
                currentQuestions = shuffle([...currentPool]);
            } else {
                currentQuestions = [...currentPool];
            }

            // Cap question count if needed
            let limit = currentQuestions.length;
            if (questionCountVal !== 'all') {
                limit = Math.min(parseInt(questionCountVal), currentQuestions.length);
            }
            currentQuestions = currentQuestions.slice(0, limit);

            // Reset game state
            currentIndex = 0;
            score = { correct: 0, incorrect: 0 };
            incorrectReviews = [];
            hasAnswered = false;

            // Display active quiz interface
            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            document.getElementById('result-screen').classList.add('hidden');

            loadQuestion();
        }

        // Restart same set
        function restartQuiz() {
            if (incorrectReviews.length === 0 && currentQuestions.length === 0) {
                startQuiz();
                return;
            }
            currentIndex = 0;
            score = { correct: 0, incorrect: 0 };
            incorrectReviews = [];
            hasAnswered = false;

            const orderMode = document.querySelector('input[name="order-mode"]:checked').value;
            if (orderMode === 'random') {
                currentQuestions = shuffle([...currentQuestions]);
            }

            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            loadQuestion();
        }

        // Special session for mistake review
        function startMistakesOnlyQuiz() {
            currentQuestions = shuffle([...incorrectReviews]);
            currentIndex = 0;
            score = { correct: 0, incorrect: 0 };
            incorrectReviews = [];
            hasAnswered = false;

            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            loadQuestion();
        }

        // Load question content
        function loadQuestion() {
            hasAnswered = false;
            selectedBtn = null;

            document.getElementById('feedback-container').classList.add('hidden');

            const current = currentQuestions[currentIndex];

            // Header progress info
            document.getElementById('current-question-num').innerText = currentIndex + 1;
            document.getElementById('total-questions-num').innerText = currentQuestions.length;
            document.getElementById('correct-count').innerText = score.correct;
            document.getElementById('incorrect-count').innerText = score.incorrect;

            // Progress bar update
            const progressPercent = ((currentIndex + 1) / currentQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;

            // Card details
            document.getElementById('question-char').innerText = current.word;
            document.getElementById('question-pinyin').innerText = current.pinyin;
            document.getElementById('word-id').innerText = `#${current.id}`;

            // Generate distractors
            let choices = [current.meaning];
            const distractorPool = vocabulary.filter(v => v.meaning !== current.meaning);
            shuffle(distractorPool);

            for (let i = 0; i < 3; i++) {
                if (distractorPool[i]) {
                    choices.push(distractorPool[i].meaning);
                }
            }

            shuffle(choices);

            // Options rendering
            const container = document.getElementById('options-container');
            container.innerHTML = '';

            const prefixes = ['A', 'B', 'C', 'D'];
            choices.forEach((choice, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full p-4 text-left border border-slate-200 hover:border-red-400 hover:bg-red-50/20 rounded-2xl font-medium transition duration-150 flex items-center bg-white shadow-sm active:scale-[0.99]";
                btn.innerHTML = `
                    <span class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold mr-3.5 text-sm flex-shrink-0 transition-colors">${prefixes[idx]}</span>
                    <span class="text-slate-700 text-base leading-snug font-semibold option-text">${choice}</span>
                `;
                btn.onclick = () => selectOption(btn, choice, current.meaning);
                container.appendChild(btn);
            });
        }

        // Option selection behavior
        function selectOption(btn, selectedChoice, correctChoice) {
            if (hasAnswered) return;
            hasAnswered = true;
            selectedBtn = btn;

            const current = currentQuestions[currentIndex];
            const isCorrect = selectedChoice === correctChoice;

            const feedbackContainer = document.getElementById('feedback-container');
            const feedbackIcon = document.getElementById('feedback-icon');
            const feedbackTitle = document.getElementById('feedback-title');
            const feedbackDesc = document.getElementById('feedback-desc');
            const options = document.querySelectorAll('#options-container button');

            options.forEach(b => {
                b.classList.add('pointer-events-none');
                const optText = b.querySelector('.option-text').innerText;
                const badge = b.querySelector('span');

                if (optText === correctChoice) {
                    b.classList.remove('bg-white', 'border-slate-200');
                    b.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-800');
                    badge.classList.remove('bg-slate-100', 'text-slate-600');
                    badge.classList.add('bg-emerald-500', 'text-white');
                } else if (b === btn && !isCorrect) {
                    b.classList.remove('bg-white', 'border-slate-200');
                    b.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-800');
                    badge.classList.remove('bg-slate-100', 'text-slate-600');
                    badge.classList.add('bg-rose-500', 'text-white');
                } else {
                    b.classList.add('opacity-50');
                }
            });

            if (isCorrect) {
                score.correct++;
                btn.classList.add('correct-pulse');

                feedbackContainer.className = "p-4 rounded-xl flex items-center justify-between transition-all bg-emerald-50 border border-emerald-200 text-emerald-800";
                feedbackIcon.className = "w-10 h-10 rounded-full flex items-center justify-center text-white text-xl flex-shrink-0 bg-emerald-500";
                feedbackIcon.innerHTML = "✓";
                feedbackTitle.innerText = "Chính xác!";
                feedbackDesc.innerText = `Nghĩa: ${current.meaning}`;
            } else {
                score.incorrect++;
                incorrectReviews.push(current);

                feedbackContainer.className = "p-4 rounded-xl flex items-center justify-between transition-all bg-rose-50 border border-rose-200 text-rose-800";
                feedbackIcon.className = "w-10 h-10 rounded-full flex items-center justify-center text-white text-xl flex-shrink-0 bg-rose-500";
                feedbackIcon.innerHTML = "✕";
                feedbackTitle.innerText = "Chưa chính xác!";
                feedbackDesc.innerText = `Đáp án đúng là: ${correctChoice}`;
            }

            document.getElementById('correct-count').innerText = score.correct;
            document.getElementById('incorrect-count').innerText = score.incorrect;
            feedbackContainer.classList.remove('hidden');
        }

        // Advance to next question or show finish screen
        function nextQuestion() {
            currentIndex++;
            if (currentIndex < currentQuestions.length) {
                loadQuestion();
            } else {
                showResults();
            }
        }

        // Render summary screen
        function showResults() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const total = currentQuestions.length;
            const percentage = total > 0 ? Math.round((score.correct / total) * 100) : 0;

            document.getElementById('final-score').innerText = `${percentage}%`;
            document.getElementById('final-correct').innerText = score.correct;
            document.getElementById('final-incorrect').innerText = score.incorrect;

            const mistakeListEl = document.getElementById('mistake-list');
            const reviewBtn = document.getElementById('review-mistakes-btn');

            mistakeListEl.innerHTML = '';

            if (incorrectReviews.length === 0) {
                reviewBtn.classList.add('hidden');
                mistakeListEl.innerHTML = `
                    <div class="p-6 text-center text-slate-400 text-sm">
                        🎉 Xuất sắc! Bạn không trả lời sai từ nào trong lượt này.
                    </div>
                `;
            } else {
                reviewBtn.classList.remove('hidden');
                incorrectReviews.forEach(item => {
                    const row = document.createElement('div');
                    row.className = "p-3.5 flex items-center justify-between hover:bg-slate-100/60 transition";
                    row.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <span class="font-extrabold text-slate-800 text-lg">${item.word}</span>
                            <span class="text-sm font-semibold text-red-500">${item.pinyin}</span>
                        </div>
                        <span class="text-xs font-medium text-slate-600">${item.meaning}</span>
                    `;
                    mistakeListEl.appendChild(row);
                });
            }
        }
    </script>
