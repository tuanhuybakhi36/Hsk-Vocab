                                <input type="radio" name="vocab-range" value="group1" checked class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Nhóm 1 (1 - 20)</span>
                                    <span class="block text-xs text-slate-400">Từ "爱" đến "北边"</span>
                                </div>
                            </label>

                            <label class="flex items-center p-3 bg-slate-50 border border-slate-200 hover:border-red-300 rounded-xl cursor-pointer hover:bg-slate-100/50 transition">
                                <input type="radio" name="vocab-range" value="group2" class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Nhóm 2 (21 - 40)</span>
                                    <span class="block text-xs text-slate-400">Từ "北京" đến "唱"</span>
                                </div>
                            </label>

                            <label class="flex items-center p-3 bg-slate-50 border border-slate-200 hover:border-red-300 rounded-xl cursor-pointer hover:bg-slate-100/50 transition">
                                <input type="radio" name="vocab-range" value="group3" class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Nhóm 3 (41 - 60)</span>
                                    <span class="block text-xs text-slate-400">Từ "唱歌" đến "打球"</span>
                                </div>
                            </label>

                            <label class="flex items-center p-3 bg-slate-50 border border-slate-200 hover:border-red-300 rounded-xl cursor-pointer hover:bg-slate-100/50 transition">
                                <input type="radio" name="vocab-range" value="group4" class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Nhóm 4 (61 - 80)</span>
                                    <span class="block text-xs text-slate-400">Từ "大" đến "电视"</span>
                                </div>
                            </label>

                            <label class="flex items-center p-3 bg-slate-50 border border-slate-200 hover:border-red-300 rounded-xl cursor-pointer hover:bg-slate-100/50 transition">
                                <input type="radio" name="vocab-range" value="group5" class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Nhóm 5 (81 - 100)</span>
                                    <span class="block text-xs text-slate-400">Từ "电视机" đến "饭店"</span>
                                </div>
                            </label>

                            <label class="flex items-center p-3 bg-slate-50 border border-slate-200 hover:border-red-300 rounded-xl cursor-pointer hover:bg-slate-100/50 transition">
                                <input type="radio" name="vocab-range" value="all" class="w-4 h-4 text-red-600 focus:ring-red-500">
                                <div class="ml-3">
                                    <span class="block font-semibold text-slate-800 text-sm">Tất cả (1 - 100)</span>
                                    <span class="block text-xs text-slate-400">Gộp chung 100 từ</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Step 2: Select Question Mode -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">2. Số lượng câu hỏi:</label>
                            <select id="question-count" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:ring-2 focus:ring-red-500 focus:border-red-500">
                                <option value="10">Luyện nhanh (10 câu)</option>
                                <option value="20" selected>Bộ 20 câu (Theo nhóm)</option>
                                <option value="all">Toàn bộ từ trong nhóm đã chọn</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">3. Thứ tự câu hỏi:</label>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="flex items-center justify-center p-3 bg-slate-50 border border-slate-200 hover:border-red-200 rounded-xl cursor-pointer transition">
                                    <input type="radio" name="order-mode" value="sequential" checked class="w-4 h-4 text-red-600">
                                    <span class="ml-2 text-xs font-semibold text-slate-700">Theo thứ tự</span>
                                </label>
                                <label class="flex items-center justify-center p-3 bg-slate-50 border border-slate-200 hover:border-red-200 rounded-xl cursor-pointer transition">
                                    <input type="radio" name="order-mode" value="random" class="w-4 h-4 text-red-600">
                                    <span class="ml-2 text-xs font-semibold text-slate-700">Ngẫu nhiên</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Start Action Button -->
                <button onclick="startQuiz()" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-lg shadow-red-100 transition duration-200 transform active:scale-[0.99] flex items-center justify-center space-x-2">
                    <span>Bắt Đầu Ôn Tập</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <!-- Quiz Screen -->
            <div id="quiz-screen" class="hidden space-y-6">
                <!-- Progress Header -->
                <div class="flex justify-between items-center text-sm font-medium text-slate-500">
                    <div>
                        <span>Tiến trình:</span>
                        <span id="current-question-num" class="text-red-600 font-bold">1</span>/<span id="total-questions-num" class="font-bold">20</span>
