                    <div class="bg-red-50/50 border border-red-100 rounded-2xl p-4 text-center">
                        <span class="block text-[10px] md:text-xs text-red-600 font-bold uppercase tracking-wider">Tỉ lệ đúng</span>
                        <span id="final-score" class="text-2xl md:text-3xl font-extrabold text-red-700">0%</span>
                    </div>
                    <div class="bg-emerald-50/50 border border-emerald-100 rounded-2xl p-4 text-center">
                        <span class="block text-[10px] md:text-xs text-emerald-600 font-bold uppercase tracking-wider">Số câu đúng</span>
                        <span id="final-correct" class="text-2xl md:text-3xl font-extrabold text-emerald-700">0</span>
                    </div>
                    <div class="bg-rose-50/50 border border-rose-100 rounded-2xl p-4 text-center">
