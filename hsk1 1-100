                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div id="progress-bar" class="bg-gradient-to-r from-red-500 to-amber-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>

                <!-- Question Card Area -->
                <div class="text-center py-10 px-4 bg-gradient-to-b from-slate-50 to-slate-100/50 rounded-2xl border border-slate-100 relative overflow-hidden shadow-sm">
                    <span id="word-level" class="absolute top-4 left-4 px-2.5 py-1 bg-red-50 text-red-700 text-xs font-bold rounded-lg uppercase tracking-wider">
                        HSK 1
                    </span>
                    <span id="word-id" class="absolute top-4 right-4 text-xs font-bold text-slate-400">
                        #1
                    </span>
                    <h3 id="question-char" class="text-5xl md:text-6xl font-extrabold text-slate-800 tracking-wide mb-3">
                        爱
                    </h3>
                    <p id="question-pinyin" class="text-2xl text-red-500 font-semibold tracking-wide">
                        ài
                    </p>
                </div>

                <!-- Option Selection Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="options-container">
                    <!-- Options generated dynamically -->
                </div>

