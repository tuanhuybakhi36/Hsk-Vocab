                    </div>
                    <div id="mistake-list" class="max-h-60 overflow-y-auto border border-slate-100 rounded-2xl divide-y divide-slate-100 bg-slate-50">
                        <!-- Dynamic mistakes list -->
                    </div>
                </div>

                <!-- Navigation buttons -->
                <div class="flex flex-col sm:flex-row gap-3 pt-2">
                    <button onclick="restartQuiz()" class="flex-1 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-md transition active:scale-95 text-center text-sm">
                        Làm Lại Đợt Này
